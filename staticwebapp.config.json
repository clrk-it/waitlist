{
    "platform": {
        "apiRuntime": "node:20"
    },
    "routes": [
        {
            "route": "/api/*",
            "methods": [
                "OPTIONS"
            ],
            "headers": {
                "Access-Control-Allow-Origin": "*",
                "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
                "Access-Control-Allow-Headers": "*"
            }
        }
    ]
}
